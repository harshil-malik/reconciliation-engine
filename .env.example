# Copy this file to .env if you need to override a default. .env is gitignored.
#
# The default setup runs entirely offline against local llama.cpp servers and needs
# NO API KEY and no .env file at all — these are overrides, not requirements.

# Chat/extraction server (Qwen 3B). Backs PDF text extraction (Stage 0) and the
# Stage 2 match confirmation. Defaults to http://127.0.0.1:8080.
# LLAMA_SERVER_URL=http://127.0.0.1:8080

# Embeddings server, used by the Stage 2 shortlist. A separate process because
# llama-server hosts one model per port. Defaults to http://127.0.0.1:8081.
# LLAMA_EMBEDDING_SERVER_URL=http://127.0.0.1:8081

# Per-request timeout in seconds. A 3B model on CPU is slow; raise this if a large
# statement extraction times out. Defaults to 300.
# LLAMA_TIMEOUT_SECONDS=300

# --- Optional hosted providers -------------------------------------------------
# Only needed if you switch main.py's get_vision_extractor() / get_embedding_client()
# / get_match_confirmer() to the hosted implementations instead of the local ones.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# --- Landing page: "Book a demo" (api/leads.js) --------------------------------
# This is the one part of the project that isn't local-first: landing.html is a
# public marketing page deployed on Vercel, and api/leads.js is a Vercel serverless
# function it posts to. These are Vercel project env vars, not read by the Python
# app above — listed here only because this is the project's one .env.example.
#
# MongoDB Atlas connection string. The lead is written to the "munim" database's
# "leads" collection before the visitor ever reaches the Cal.com booking step, so an
# abandoned form still leaves a callable lead.
# MONGODB_URI=mongodb+srv://...
#
# Telegram bot that pings you the moment a demo is requested. Optional — the lead is
# saved either way. To set one up: message @BotFather, send /newbot, copy the token;
# message your new bot once (anything); then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy the "chat":{"id": ...} value.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=987654321
