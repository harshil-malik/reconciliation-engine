# Local GGUF model weights — multi-GB, downloaded per machine (see README.md)
models/
*.gguf
# Generated test fixtures — rebuild with scripts/make_sample_data.py
sample_data/
# Real client statements — never commit. Financial data, redacted or not.
private/
# Saved client history: the SQLite database holds every reconciliation a CA has run,
# the uploaded statements and ledgers themselves, and the workbooks built from them.
# It is the single largest concentration of client financial data in the project.
data/
# Desktop build: bundled llama.cpp binary, PyInstaller work/output, and the
# distributable zip. All are downloaded or generated by build_windows.ps1.
desktop/bin/
build/
dist/
*.zip
# api/leads.js dependencies (mongodb, zod) — Vercel installs these itself on deploy.
node_modules/
